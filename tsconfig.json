{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": [
      "es2017"
    ],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@hooks/*": [
        "lib/hooks/*"
      ],
      "@utilities": [
        "lib/utilities/index.ts"
      ],
      "@utilities/*": [
        "lib/utilities/*"
      ],
      "@integrations/*": [
        "lib/integrations/*"
      ],
      "@modules/*": [
        "lib/modules/*"
      ],
      "@components/*": [
        "lib/components/*"
      ],
      "@services/*": [
        "lib/services/*"
      ]
    },
    "typeRoots": [
      "./env.d.ts"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ],
  "extends": "expo/tsconfig.base"
}
