{
  "name": "goal",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "expo:start": "expo start --dev-client -c",
    "expo:start:staging": "NODE_OPTIONS=--max_old_space_size=4096 APP_ENV=staging yarn expo:start",
    "android": "react-native run-android warning-mode=all --variant=prodDebug --appIdSuffix=apps",
    "android:staging": "APP_ENV=staging yarn android",
    "ios": "react-native run-ios",
    "ios:staging": "APP_ENV=staging yarn ios",
    "ios-iPhone11": "react-native run-ios --simulator='iPhone 11'",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "reset-env": "yarn start --reset-cache",
    "bundle:ios": "./node_modules/.bin/react-native bundle --platform ios --entry-file index.js --bundle-output ./CodePush/ios/main.jsbundle --assets-dest ./CodePush/ios --dev false --reset-cache",
    "codepush:prod:ios": "appcenter codepush release-react -a app_team/Goal-ios -d Production-Appstore -t 1.0.7",
    "codepush:prod:ios:mandatory": "appcenter codepush release-react -a app_team/Goal-ios -d Production-Appstore -m -t 1.0.7",
    "codepush:prod:android": "appcenter codepush release-react -a app_team/Goal-android -d Production -t 1.0.7",
    "codepush:prod:android:mandatory": "appcenter codepush release-react -a app_team/Goal-android -d Production -m -t 1.0.7",
    "codepush:staging:ios": "appcenter codepush release-react -a app_team/Goal-ios -d Staging -t 1.0.7",
    "codepush:staging:ios:mandatory": "appcenter codepush release-react -a app_team/Goal-ios -d Staging -m -t 1.0.7",
    "codepush:staging:android": "appcenter codepush release-react -a app_team/Goal-android -d Staging -t 1.0.7",
    "codepush:staging:android:mandatory": "appcenter codepush release-react -a app_team/Goal-android -d Staging -m -t 1.0.7",
    "postinstall": "patch-package",
    "sourcemap:android": "react-native bundle --dev false --platform android --entry-file index.js --reset-cache --bundle-output index.android.bundle --sourcemap-output index.android.bundle.map"
  },
